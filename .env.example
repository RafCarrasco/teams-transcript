# Copie para `.env` e preencha. NÃO commite o `.env`.

# Google Gemini — free tier. Gere em https://aistudio.google.com/apikey
# Não precisa de cartão de crédito.
GEMINI_API_KEY=

# HuggingFace — necessário para baixar o modelo de diarização (pyannote).
# Gratuito. Gere em https://huggingface.co/settings/tokens
HF_TOKEN=
